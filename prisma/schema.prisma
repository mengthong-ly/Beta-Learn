generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Server copy of the per-learner data in lib/db.ts (Dexie). Run history stays local.
// Keys use the same "<course>/<lesson>" format as the browser tables.

model User {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  progress  Progress[]
  drafts    Draft[]
  quizzes   QuizResult[]
  reads     LessonRead[]
}

model Progress {
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

model Draft {
  userId    String
  lessonId  String
  code      String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

/// Best score per quiz. key: "python/print" (lesson), "python/section:2", "python/final".
model QuizResult {
  userId   String
  key      String
  best     Int
  total    Int
  passedAt DateTime?
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

model LessonRead {
  userId   String
  lessonId String
  readAt   DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}
